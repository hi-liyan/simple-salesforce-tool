{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Simple Salesforce Tool",
  "version": "0.5.1",
  "identifier": "com.iyucode.simple-salesforce-tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Salesforce Tool",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#F2F4F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNDIzNDQ2MEI5MTFBQjYKUldTMkdwRUxSalJDckN2M1pESkxyWWY2clJobVl6Z3ZEcnp0V2hoWW5TUGpTZjRxMWd2VjVwWXoK",
      "endpoints": [
        "https://github.com/hi-liyan/simple-salesforce-tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
