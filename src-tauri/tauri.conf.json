{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Simple Salesforce Tool",
  "version": "0.1.15",
  "identifier": "com.iyucode.simple-salesforce-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Salesforce Tool",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
